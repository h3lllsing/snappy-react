# Backend wiring (leave unset to keep the mock/demo API)
VITE_API_URL=/api
VITE_AUTH_MODE=cookie        # cookie | bearer
VITE_USE_API=false           # true to use Laravel /api instead of mocks

# Reverb (activate in P5)
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
